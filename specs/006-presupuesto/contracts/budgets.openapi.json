{
  "openapi": "3.1.0",
  "info": {
    "title": "Nova API — Presupuesto (spec 006)",
    "version": "1.0.0",
    "description": "Contrato de diseño de la funcionalidad 006-presupuesto. Todas las rutas exigen sesión (cookie `nova_at`). Montos en pesos colombianos enteros. Todo error usa `ErrorResponse`. El presupuesto es informativo: ninguna operación mueve dinero."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "accessCookie": []
    }
  ],
  "tags": [
    {
      "name": "budgets"
    }
  ],
  "paths": {
    "/budgets": {
      "get": {
        "tags": [
          "budgets"
        ],
        "operationId": "getBudgetMonth",
        "summary": "Resumen de un mes por categoría",
        "parameters": [
          {
            "in": "query",
            "name": "month",
            "required": false,
            "description": "Mes actual (por defecto) o uno de los 6 anteriores, en hora de Bogotá",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
              "examples": [
                "2026-11"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetMonth"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      }
    },
    "/budgets/limits/{category}": {
      "put": {
        "tags": [
          "budgets"
        ],
        "operationId": "setBudgetLimit",
        "summary": "Poner o cambiar el tope mensual (desde este mes)",
        "parameters": [
          {
            "in": "path",
            "name": "category",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BudgetCategory"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetBudgetLimitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resumen del mes actual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetMonth"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      },
      "delete": {
        "tags": [
          "budgets"
        ],
        "operationId": "removeBudgetLimit",
        "summary": "Quitar el tope (desde este mes)",
        "parameters": [
          {
            "in": "path",
            "name": "category",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BudgetCategory"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumen del mes actual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetMonth"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      }
    },
    "/budgets/transfers": {
      "get": {
        "tags": [
          "budgets"
        ],
        "operationId": "listBudgetTransfers",
        "summary": "Transferencias enviadas en un mes, con su categoría",
        "parameters": [
          {
            "in": "query",
            "name": "month",
            "required": false,
            "description": "Mes actual (por defecto) o uno de los 6 anteriores, en hora de Bogotá",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
              "examples": [
                "2026-11"
              ]
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de transferencias",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetTransfersPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      }
    },
    "/budgets/transfers/{transactionId}/category": {
      "put": {
        "tags": [
          "budgets"
        ],
        "operationId": "setTransferCategory",
        "summary": "Reclasificar una transferencia enviada",
        "parameters": [
          {
            "in": "path",
            "name": "transactionId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetTransferCategoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transferencia con su categoría",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetTransfer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "404": {
            "description": "`NOT_FOUND`: no existe o no la envió la estudiante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/budgets/alerts": {
      "get": {
        "tags": [
          "budgets"
        ],
        "operationId": "listBudgetAlerts",
        "summary": "Alertas del mes actual, de la más nueva a la más vieja",
        "responses": {
          "200": {
            "description": "Alertas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetAlertList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      }
    },
    "/budgets/alerts/{alertId}/seen": {
      "post": {
        "tags": [
          "budgets"
        ],
        "operationId": "markBudgetAlertSeen",
        "summary": "Marcar una alerta como vista",
        "parameters": [
          {
            "in": "path",
            "name": "alertId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Alerta vista",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetAlert"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "404": {
            "description": "`NOT_FOUND`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nova_at"
      }
    },
    "responses": {
      "ValidationError": {
        "description": "`VALIDATION_ERROR`",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "SessionInvalid": {
        "description": "`UNAUTHENTICATED`, `ACCESS_TOKEN_EXPIRED` o `SESSION_EXPIRED`",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "BudgetCategory": {
        "type": "string",
        "enum": [
          "food",
          "books",
          "transport",
          "stationery",
          "entertainment",
          "transfers",
          "other"
        ]
      },
      "BudgetStatus": {
        "type": "string",
        "enum": [
          "none",
          "ok",
          "warning",
          "exceeded"
        ]
      },
      "Month": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
        "examples": [
          "2026-11"
        ]
      },
      "BudgetCategorySummary": {
        "type": "object",
        "required": [
          "category",
          "spent",
          "limit",
          "percent",
          "status"
        ],
        "properties": {
          "category": {
            "$ref": "#/components/schemas/BudgetCategory"
          },
          "spent": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1000,
            "maximum": 50000000
          },
          "percent": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Puede pasar de 100"
          },
          "status": {
            "$ref": "#/components/schemas/BudgetStatus"
          }
        }
      },
      "BudgetMonth": {
        "type": "object",
        "required": [
          "month",
          "totalSpent",
          "categories"
        ],
        "properties": {
          "month": {
            "$ref": "#/components/schemas/Month"
          },
          "totalSpent": {
            "type": "integer",
            "minimum": 0
          },
          "categories": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "description": "Las 7 categorías, en el orden de BudgetCategory",
            "items": {
              "$ref": "#/components/schemas/BudgetCategorySummary"
            }
          }
        }
      },
      "SetBudgetLimitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "monthlyLimit"
        ],
        "properties": {
          "monthlyLimit": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 50000000,
            "examples": [
              200000
            ]
          }
        }
      },
      "BudgetTransfer": {
        "type": "object",
        "required": [
          "transactionId",
          "description",
          "amount",
          "createdAt",
          "category"
        ],
        "properties": {
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "examples": [
              "Transferencia a Ana P. G."
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "category": {
            "$ref": "#/components/schemas/BudgetCategory"
          }
        }
      },
      "BudgetTransfersPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/BudgetTransfer"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SetTransferCategoryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category"
        ],
        "properties": {
          "category": {
            "$ref": "#/components/schemas/BudgetCategory"
          }
        }
      },
      "BudgetAlert": {
        "type": "object",
        "required": [
          "id",
          "month",
          "category",
          "threshold",
          "spent",
          "limit",
          "createdAt",
          "seen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "month": {
            "$ref": "#/components/schemas/Month"
          },
          "category": {
            "$ref": "#/components/schemas/BudgetCategory"
          },
          "threshold": {
            "type": "integer",
            "enum": [
              80,
              100
            ],
            "description": "80: «Te estás acercando»; 100: «Superaste el presupuesto»"
          },
          "spent": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "seen": {
            "type": "boolean"
          }
        }
      },
      "BudgetAlertList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BudgetAlert"
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "ACCESS_TOKEN_EXPIRED",
          "SESSION_EXPIRED",
          "NOT_FOUND",
          "INTERNAL_ERROR"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "details": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "idle",
                      "absolute",
                      "revoked"
                    ]
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
