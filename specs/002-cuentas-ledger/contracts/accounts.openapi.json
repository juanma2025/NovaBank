{
  "openapi": "3.1.0",
  "info": {
    "title": "Nova API — Cuentas, libro contable y recargas (spec 002)",
    "version": "1.0.0",
    "description": "Contrato de diseño de la funcionalidad 002-cuentas-ledger. Es la fuente de verdad entre backend y frontend: el documento generado en `/api/v1/openapi.json` DEBE coincidir con él.\n\nTodas las rutas exigen sesión (cookie `nova_at`, spec 001). Los montos viajan como enteros en pesos colombianos (constitución, Principio I). Todo error usa `ErrorResponse`.\n\nCambio aprobado en la definición de la spec 003: `Movement.type` incluye `transfer` y `Movement` incluye `note`."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "accounts"
    },
    {
      "name": "topups"
    }
  ],
  "security": [
    {
      "accessCookie": []
    }
  ],
  "paths": {
    "/accounts/me": {
      "get": {
        "tags": [
          "accounts"
        ],
        "operationId": "getMyAccount",
        "summary": "Cuenta del estudiante con su saldo y los 5 movimientos más recientes",
        "description": "Crea la cuenta si todavía no existe (FR-001, research R6).",
        "responses": {
          "200": {
            "description": "Cuenta del estudiante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      }
    },
    "/accounts/me/movements": {
      "get": {
        "tags": [
          "accounts"
        ],
        "operationId": "listMyMovements",
        "summary": "Historial de movimientos, del más nuevo al más antiguo, paginado por cursor",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "description": "Valor `nextCursor` de la página anterior; omitir para la primera página",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de movimientos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovementsPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      }
    },
    "/topups/limits": {
      "get": {
        "tags": [
          "topups"
        ],
        "operationId": "getTopupLimits",
        "summary": "Límites de recarga y lo que le queda hoy al estudiante",
        "responses": {
          "200": {
            "description": "Límites vigentes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopupLimits"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      }
    },
    "/topups": {
      "post": {
        "tags": [
          "topups"
        ],
        "operationId": "createTopup",
        "summary": "Recarga simulada (dinero de demostración)",
        "description": "Exige la cabecera `Idempotency-Key`. Repetir la misma clave con el mismo cuerpo devuelve la respuesta original sin aplicar otra recarga; con un cuerpo distinto, 409.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "description": "Identificador único del intento (UUID recomendado)",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTopupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recarga aplicada (o respuesta original si se repitió la clave)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopupResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "409": {
            "description": "`IDEMPOTENCY_KEY_REUSED`: la clave ya se usó con otro cuerpo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`TOPUP_AMOUNT_OUT_OF_RANGE` (details.minAmount, details.maxAmount) o `TOPUP_DAILY_LIMIT` (details.remainingToday)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "`RATE_LIMITED`",
            "headers": {
              "Retry-After": {
                "description": "Segundos hasta poder reintentar",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nova_at"
      }
    },
    "responses": {
      "ValidationError": {
        "description": "`VALIDATION_ERROR` — incluye la falta de `Idempotency-Key`",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "SessionInvalid": {
        "description": "`UNAUTHENTICATED`, `ACCESS_TOKEN_EXPIRED` o `SESSION_EXPIRED`",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "MoneyAmount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "Pesos colombianos enteros",
        "examples": [
          50000
        ]
      },
      "Movement": {
        "type": "object",
        "required": [
          "id",
          "transactionId",
          "type",
          "description",
          "note",
          "amount",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "topup",
              "transfer"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 140,
            "examples": [
              "Recarga simulada",
              "Transferencia a Ana P. G."
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 140,
            "description": "Nota de la transferencia; null si no hay"
          },
          "amount": {
            "type": "integer",
            "description": "Con signo, desde la cuenta del estudiante: + entra, − sale"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed",
              "reversed"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccountSummary": {
        "type": "object",
        "required": [
          "id",
          "currency",
          "balance",
          "recentMovements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "const": "COP"
          },
          "balance": {
            "type": "integer",
            "minimum": 0
          },
          "recentMovements": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/Movement"
            }
          }
        }
      },
      "MovementsPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Movement"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "null si no hay más páginas"
          }
        }
      },
      "TopupLimits": {
        "type": "object",
        "required": [
          "minAmount",
          "maxAmount",
          "dailyLimit",
          "remainingToday"
        ],
        "properties": {
          "minAmount": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "maxAmount": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "dailyLimit": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "remainingToday": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CreateTopupRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount"
        ],
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/MoneyAmount"
          }
        }
      },
      "TopupResult": {
        "type": "object",
        "required": [
          "movement",
          "balance"
        ],
        "properties": {
          "movement": {
            "$ref": "#/components/schemas/Movement"
          },
          "balance": {
            "type": "integer",
            "minimum": 0,
            "description": "Saldo después de la recarga"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "ACCESS_TOKEN_EXPIRED",
          "SESSION_EXPIRED",
          "RATE_LIMITED",
          "NOT_FOUND",
          "INTERNAL_ERROR",
          "TOPUP_AMOUNT_OUT_OF_RANGE",
          "TOPUP_DAILY_LIMIT",
          "IDEMPOTENCY_KEY_REUSED"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "details": {
                "type": "object",
                "properties": {
                  "retryAfterSeconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minAmount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxAmount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "remainingToday": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "idle",
                      "absolute",
                      "revoked"
                    ]
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}