{
  "openapi": "3.1.0",
  "info": {
    "title": "Nova API — Tarjeta virtual y tienda demo (spec 004)",
    "version": "1.0.0",
    "description": "Contrato de diseño de la funcionalidad 004-tarjeta-virtual. Todas las rutas exigen sesión (cookie `nova_at`). Montos en pesos colombianos enteros. Todo error usa `ErrorResponse`. Ninguna respuesta incluye el número completo ni el CVV, salvo `POST /cards/{cardId}/reveal`."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "accessCookie": []
    }
  ],
  "tags": [
    {
      "name": "cards"
    },
    {
      "name": "store"
    }
  ],
  "paths": {
    "/cards": {
      "get": {
        "tags": [
          "cards"
        ],
        "operationId": "listMyCards",
        "summary": "Mis tarjetas, incluidas las canceladas",
        "responses": {
          "200": {
            "description": "Tarjetas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      },
      "post": {
        "tags": [
          "cards"
        ],
        "operationId": "issueCard",
        "summary": "Emitir una tarjeta",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardNicknameRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tarjeta emitida, activa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "422": {
            "description": "`CARD_LIMIT_REACHED`: ya tiene 3 tarjetas vigentes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "`RATE_LIMITED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{cardId}": {
      "patch": {
        "tags": [
          "cards"
        ],
        "operationId": "renameCard",
        "summary": "Cambiar el nombre",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardNicknameRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarjeta actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "404": {
            "description": "`NOT_FOUND`: no existe o es de otro estudiante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`CARD_CANCELED`: la tarjeta está cancelada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{cardId}/freeze": {
      "post": {
        "tags": [
          "cards"
        ],
        "operationId": "freezeCard",
        "summary": "Congelar (sin cambio si ya está congelada)",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tarjeta con su estado actual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "404": {
            "description": "`NOT_FOUND`: no existe o es de otro estudiante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`CARD_CANCELED`: la tarjeta está cancelada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{cardId}/unfreeze": {
      "post": {
        "tags": [
          "cards"
        ],
        "operationId": "unfreezeCard",
        "summary": "Descongelar (sin cambio si ya está activa)",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tarjeta con su estado actual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "404": {
            "description": "`NOT_FOUND`: no existe o es de otro estudiante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`CARD_CANCELED`: la tarjeta está cancelada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{cardId}/cancel": {
      "post": {
        "tags": [
          "cards"
        ],
        "operationId": "cancelCard",
        "summary": "Cancelar de forma definitiva",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tarjeta con su estado actual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "404": {
            "description": "`NOT_FOUND`: no existe o es de otro estudiante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`CARD_CANCELED`: la tarjeta está cancelada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{cardId}/reveal": {
      "post": {
        "tags": [
          "cards"
        ],
        "operationId": "revealCard",
        "summary": "Ver número completo, vencimiento y CVV con la contraseña",
        "description": "Responde con `Cache-Control: no-store`. Comparte el bloqueo de reautenticación de la spec 003.",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevealCardRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Datos completos",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardSecrets"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "404": {
            "description": "`NOT_FOUND`: no existe o es de otro estudiante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`CARD_CANCELED`: la tarjeta está cancelada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`REAUTH_FAILED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "`REAUTH_LOCKED` (retryAfterSeconds) o `RATE_LIMITED`",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{cardId}/payments": {
      "get": {
        "tags": [
          "cards"
        ],
        "operationId": "listCardPayments",
        "summary": "Pagos aprobados de la tarjeta",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de pagos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardPaymentsPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "404": {
            "description": "`NOT_FOUND`: no existe o es de otro estudiante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/store/limits": {
      "get": {
        "tags": [
          "store"
        ],
        "operationId": "getPaymentLimits",
        "summary": "Límites de pago y lo que queda hoy",
        "responses": {
          "200": {
            "description": "Límites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentLimits"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          }
        }
      }
    },
    "/store/payments": {
      "post": {
        "tags": [
          "store"
        ],
        "operationId": "createCardPayment",
        "summary": "Pagar en un comercio de la tienda demo",
        "description": "Exige `Idempotency-Key`. Solo acepta tarjetas del estudiante con sesión. El número, el vencimiento y el CVV no forman parte del hash de idempotencia ni se guardan.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCardPaymentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pago aprobado (o respuesta original si se repitió la clave)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardPaymentResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/SessionInvalid"
          },
          "409": {
            "description": "`IDEMPOTENCY_KEY_REUSED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`CARD_DECLINED` (datos que no coinciden, sin decir cuál), `CARD_NOT_ACTIVE`, `PAYMENT_AMOUNT_OUT_OF_RANGE` (minAmount, maxAmount), `PAYMENT_DAILY_LIMIT` (remainingToday) o `INSUFFICIENT_FUNDS` (availableBalance)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "`CARD_PAYMENTS_LOCKED` (retryAfterSeconds) o `RATE_LIMITED`",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nova_at"
      }
    },
    "responses": {
      "ValidationError": {
        "description": "`VALIDATION_ERROR`",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "SessionInvalid": {
        "description": "`UNAUTHENTICATED`, `ACCESS_TOKEN_EXPIRED` o `SESSION_EXPIRED`",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "MoneyAmount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "examples": [
          12000
        ]
      },
      "CardStatus": {
        "type": "string",
        "enum": [
          "active",
          "frozen",
          "canceled"
        ]
      },
      "Card": {
        "type": "object",
        "required": [
          "id",
          "nickname",
          "last4",
          "expMonth",
          "expYear",
          "holderName",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "examples": [
              "Compras en línea"
            ]
          },
          "last4": {
            "type": "string",
            "pattern": "^[0-9]{4}$",
            "examples": [
              "1234"
            ]
          },
          "expMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "expYear": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2999
          },
          "holderName": {
            "type": "string",
            "examples": [
              "ANA PÉREZ GÓMEZ"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/CardStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CardList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          }
        }
      },
      "CardNicknameRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nickname"
        ],
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "Se recortan los espacios"
          }
        }
      },
      "RevealCardRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "CardSecrets": {
        "type": "object",
        "required": [
          "number",
          "expMonth",
          "expYear",
          "cvv"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^9[0-9]{15}$",
            "examples": [
              "9012345678901234"
            ]
          },
          "expMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "expYear": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2999
          },
          "cvv": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          }
        }
      },
      "MerchantId": {
        "type": "string",
        "enum": [
          "cafeteria-central",
          "restaurante-la-u",
          "libreria-campus",
          "bus-universitario",
          "papeleria-express",
          "cine-estudiantil"
        ],
        "description": "Comercios de `DEMO_MERCHANTS`"
      },
      "MerchantCategory": {
        "type": "string",
        "enum": [
          "food",
          "books",
          "transport",
          "stationery",
          "entertainment"
        ]
      },
      "CardPayment": {
        "type": "object",
        "required": [
          "id",
          "transactionId",
          "merchantId",
          "merchantName",
          "category",
          "amount",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "merchantId": {
            "$ref": "#/components/schemas/MerchantId"
          },
          "merchantName": {
            "type": "string",
            "examples": [
              "Cafetería Central"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/MerchantCategory"
          },
          "amount": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CardPaymentsPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/CardPayment"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PaymentLimits": {
        "type": "object",
        "required": [
          "minAmount",
          "maxAmount",
          "dailyLimit",
          "remainingToday"
        ],
        "properties": {
          "minAmount": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "maxAmount": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "dailyLimit": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "remainingToday": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CreateCardPaymentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "merchantId",
          "amount",
          "cardNumber",
          "expiry",
          "cvv"
        ],
        "properties": {
          "merchantId": {
            "$ref": "#/components/schemas/MerchantId"
          },
          "amount": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "cardNumber": {
            "type": "string",
            "pattern": "^[0-9 ]{16,19}$",
            "description": "16 dígitos; se aceptan espacios",
            "examples": [
              "9012 3456 7890 1234"
            ]
          },
          "expiry": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-2])/[0-9]{2}$",
            "examples": [
              "11/30"
            ]
          },
          "cvv": {
            "type": "string",
            "pattern": "^[0-9]{3}$",
            "examples": [
              "123"
            ]
          }
        }
      },
      "Movement": {
        "type": "object",
        "required": [
          "id",
          "transactionId",
          "type",
          "description",
          "note",
          "amount",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "topup",
              "transfer",
              "card_payment"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 140,
            "examples": [
              "Recarga simulada",
              "Transferencia a Ana P. G.",
              "Compra en Cafetería Central · •••• 1234"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 140,
            "description": "Nota de la transferencia; null si no hay"
          },
          "amount": {
            "type": "integer",
            "description": "Con signo, desde la cuenta del estudiante: + entra, − sale"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed",
              "reversed"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CardPaymentResult": {
        "type": "object",
        "required": [
          "movement",
          "balance",
          "cardLast4"
        ],
        "properties": {
          "movement": {
            "$ref": "#/components/schemas/Movement"
          },
          "balance": {
            "type": "integer",
            "minimum": 0
          },
          "cardLast4": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "ACCESS_TOKEN_EXPIRED",
          "SESSION_EXPIRED",
          "RATE_LIMITED",
          "NOT_FOUND",
          "INTERNAL_ERROR",
          "IDEMPOTENCY_KEY_REUSED",
          "INSUFFICIENT_FUNDS",
          "REAUTH_FAILED",
          "REAUTH_LOCKED",
          "CARD_LIMIT_REACHED",
          "CARD_CANCELED",
          "CARD_NOT_ACTIVE",
          "CARD_DECLINED",
          "CARD_PAYMENTS_LOCKED",
          "PAYMENT_AMOUNT_OUT_OF_RANGE",
          "PAYMENT_DAILY_LIMIT"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "details": {
                "type": "object",
                "properties": {
                  "retryAfterSeconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minAmount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxAmount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "remainingToday": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "availableBalance": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "idle",
                      "absolute",
                      "revoked"
                    ]
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
