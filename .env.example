# =============================================================================
# Nova — variables de entorno (plantilla)
# Copia este archivo a .env y completa los secretos. .env NUNCA se sube a git.
# El backend valida todas estas variables con Zod al arrancar: si falta una
# requerida, no arranca (Principio VI).
# =============================================================================

# --- Servidor ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Origen del frontend: CORS y verificación de Origin en peticiones que modifican datos.
APP_ORIGIN=http://localhost:5173
# Cantidad de proxies de confianza para leer la IP real (0 en local, 1 en Render).
TRUST_PROXY=0
LOG_LEVEL=info
# true solo en producción y E2E: Express sirve frontend/dist (un solo origen, research R14).
SERVE_FRONTEND=false

# --- Base de datos -------------------------------------------------------------
# docker compose levanta PostgreSQL 17 con usuario/clave nova/nova.
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova

# --- Secretos (OBLIGATORIOS) --------------------------------------------------
# Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Firma de los JWT de acceso.
JWT_ACCESS_SECRET=
# Clave del HMAC de los códigos de verificación.
CODE_HMAC_SECRET=

# --- Registro -----------------------------------------------------------------
# Dominios institucionales permitidos, separados por coma (coincidencia exacta).
# nova-test.edu.co es solo para pruebas automáticas: no lo habilites aquí.
STUDENT_EMAIL_DOMAINS=ucc.edu.co

# --- Correo (Mailpit en desarrollo) -------------------------------------------
# Bandeja de prueba: http://localhost:8025. En producción, el SMTP del proveedor (Brevo).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nova <no-reply@nova.local>"

# --- Solo desarrollo y E2E (prohibidas si NODE_ENV=production) -----------------
# Reducen la inactividad y el aviso para probar «Seguir conectado» sin esperar 14 min.
# El aviso debe ser menor que la inactividad. Ejemplo: 20 y 8.
# SESSION_IDLE_TIMEOUT_SECONDS_OVERRIDE=20
# SESSION_IDLE_WARNING_SECONDS_OVERRIDE=8
