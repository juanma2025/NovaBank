# =============================================================================
# Nova — variables de entorno (plantilla)
# Copia este archivo a .env y completa los secretos. .env NUNCA se sube a git.
# El backend valida todas estas variables con Zod al arrancar: si falta una
# requerida, no arranca (Principio VI).
# =============================================================================

# --- Servidor ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Origen del frontend: CORS y verificación de Origin en peticiones que modifican datos.
APP_ORIGIN=http://localhost:5173
# Cantidad de proxies de confianza para leer la IP real (0 en local, 1 en Render).
TRUST_PROXY=0
LOG_LEVEL=info
# true solo en producción y E2E: Express sirve frontend/dist (un solo origen, research R14).
SERVE_FRONTEND=false

# --- Base de datos -------------------------------------------------------------
# docker compose levanta PostgreSQL 17 con usuario/clave nova/nova en el puerto 5433
# (no 5432, para no chocar con un PostgreSQL instalado en Windows).
DATABASE_URL=postgresql://nova:nova@localhost:5433/nova

# --- Secretos (OBLIGATORIOS) --------------------------------------------------
# Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Firma de los JWT de acceso.
JWT_ACCESS_SECRET=
# Clave del HMAC de los códigos de verificación.
CODE_HMAC_SECRET=

# --- Registro -----------------------------------------------------------------
# Dominios institucionales permitidos, separados por coma (coincidencia exacta).
# nova-test.edu.co es solo para pruebas automáticas: no lo habilites aquí.
STUDENT_EMAIL_DOMAINS=ucc.edu.co

# --- Correo (Mailpit en desarrollo) -------------------------------------------
# Bandeja de prueba: http://localhost:8025. En producción, el SMTP del proveedor (Brevo).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nova <no-reply@nova.local>"

# --- Recargas simuladas (spec 002) ---------------------------------------------
# Pesos enteros. Regla: mínimo ≤ máximo ≤ tope diario. El día se cuenta en hora de Colombia.
# Monto mínimo por recarga.
TOPUP_MIN_AMOUNT=1000
# Monto máximo por recarga.
TOPUP_MAX_AMOUNT=500000
# Tope de recargas por estudiante y por día.
TOPUP_DAILY_LIMIT=2000000

# --- Transferencias (spec 003) -----------------------------------------------
# Pesos enteros. Regla: mínimo ≤ umbral ≤ máximo ≤ tope diario. El día se cuenta en hora de Colombia.
# Monto mínimo por transferencia.
TRANSFER_MIN_AMOUNT=1000
# Monto máximo por transferencia.
TRANSFER_MAX_AMOUNT=500000
# Tope de lo enviado por estudiante y por día (lo recibido no cuenta).
TRANSFER_DAILY_LIMIT=1000000
# Por encima de este monto se pide la contraseña.
TRANSFER_REAUTH_THRESHOLD=200000

# --- Tarjeta virtual (spec 004) ----------------------------------------------
# OBLIGATORIA. Clave para cifrar los números de tarjeta: 64 caracteres hexadecimales (32 bytes).
# Genera una con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Si la cambias, las tarjetas ya emitidas no se pueden descifrar.
CARD_ENCRYPTION_KEY=
# Pesos enteros. Regla: mínimo ≤ máximo ≤ tope diario. El día se cuenta en hora de Colombia.
# Monto mínimo por pago con tarjeta.
CARD_PAYMENT_MIN_AMOUNT=1000
# Monto máximo por pago con tarjeta.
CARD_PAYMENT_MAX_AMOUNT=500000
# Tope de pagos con tarjeta por estudiante y por día (todas sus tarjetas).
CARD_PAYMENT_DAILY_LIMIT=1000000

# --- Solo desarrollo y E2E (prohibidas si NODE_ENV=production) -----------------
# Reducen la inactividad y el aviso para probar «Seguir conectado» sin esperar 14 min.
# El aviso debe ser menor que la inactividad. Ejemplo: 20 y 8.
# SESSION_IDLE_TIMEOUT_SECONDS_OVERRIDE=20
# SESSION_IDLE_WARNING_SECONDS_OVERRIDE=8
